<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoJaNai.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hypertext="clr-namespace:HyperText.Avalonia.Controls;assembly=HyperText.Avalonia"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:lang="clr-namespace:VideoJaNai.Lang"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="600"
        x:Class="VideoJaNai.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="VideoJaNai">

  <Window.Styles>
    <Style Selector="TabControl[TabStripPlacement=Top]">
      <!-- Override styled behaviour -->
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Responsive help text: gray, small, wraps to whatever width its grid column gives it. -->
    <Style Selector="TextBlock.help">
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>
    <Style Selector="SelectableTextBlock.help">
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>
    <Style Selector="Border.border">

      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderBrush" Value="#33888888" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.active">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor }" />
      <Style Selector="^:pointerover">
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
          <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
      </Style>
    </Style>
    <!-- The settings page's collapsible sections: a bold title (or the switch that enables the
         section) and a grey one-line summary of its settings. -->
    <Style Selector="Expander.section">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <!-- open and close at once: the theme's 0.25 s crossfade made sections feel slow -->
      <Setter Property="ContentTransition" Value="{x:Null}"/>
      <!-- the theme pads 16 all round; less on top, right under the header -->
      <Setter Property="Padding" Value="16,6,16,16"/>
    </Style>
    <Style Selector="Expander.section /template/ ToggleButton#ExpanderHeader">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="CheckBox.sectionTitle">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.summary">
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.row">
      <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <!-- (?) next to a setting: its explanation as a tooltip -->
    <Style Selector="materialIcons|MaterialIcon.hint">
      <Setter Property="Kind" Value="QuestionMarkCircle"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="ToolTip.ShowDelay" Value="200"/>
    </Style>
  </Window.Styles>
  
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
  <Grid>
    <Grid ColumnDefinitions="300,*" RowDefinitions="*" IsVisible="{Binding !IsExtractingBackend}">

      <DockPanel Grid.Column="0" Background="#33000000">

        <StackPanel DockPanel.Dock="Bottom">
          <Button FontSize="13" Padding="10" Classes.active="{Binding ShowAppSettings}" Width="300" HorizontalContentAlignment="Left" Command="{Binding HandleAppSettingsSelected}">
            <StackPanel Orientation="Horizontal">
              <materialIcons:MaterialIcon Kind="Gear" VerticalAlignment="Center" />
              <TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.AppSettingsButtonText}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="10" ToolTip.Tip="{x:Static lang:Resources.WorkflowsTooltip}" ToolTip.ShowDelay="200">
            <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.WorkflowsLabel}" />
            <materialIcons:MaterialIcon Kind="QuestionMarkCircle" VerticalAlignment="Center" Opacity="0.5" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Workflows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UpscaleWorkflow">
                <StackPanel>
                  <Button FontSize="13" Padding="10" Width="300" HorizontalContentAlignment="Left"
                          ClickMode="Press"
                          Classes.active="{Binding ActiveWorkflow}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).HandleWorkflowSelected}"
                          CommandParameter="{Binding WorkflowIndex}">
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="{Binding WorkflowIcon}" VerticalAlignment="Center" />
                      <TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text="{Binding WorkflowName}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </DockPanel>

      <!-- Main Form -->
      <DockPanel Grid.Column="1" IsVisible="{Binding ShowMainForm}">
        <!--Bottom Status Panel -->
        <StackPanel DockPanel.Dock="Bottom">

          <StackPanel Orientation="Horizontal">
            <Button Margin="20,10,0,10" FontWeight="Bold" Background="Green" IsEnabled="{Binding UpscaleEnabled}" Command="{Binding RunUpscale}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="PlayCircle" />
                <TextBlock Margin="5,0,0,0" Text="{x:Static lang:Resources.UpscaleButtonText}" />
              </StackPanel>

            </Button>
            <Button Margin="20,10,0,10" FontWeight="Bold" IsEnabled="{Binding PreviewEnabled}" Click="PreviewButtonClick"
                    ToolTip.Tip="{x:Static lang:Resources.PreviewWindowTooltip}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="Eye" />
                <TextBlock Margin="5,0,0,0" Text="{x:Static lang:Resources.PreviewWindowButtonText}" />
              </StackPanel>
            </Button>
            <Button Margin="20,10,0,10" FontWeight="Bold" Background="Red" IsEnabled="{Binding Upscaling}" Command="{Binding CancelUpscale}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="StopCircle" />
                <TextBlock Margin="5,0,0,0" Text="{x:Static lang:Resources.CancelButtonText}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel IsVisible="{Binding Upscaling}" Margin="20,0,20,5">
            <Image Source="{Binding PreviewImage}" MaxHeight="270" HorizontalAlignment="Left" Margin="0,0,0,8" Stretch="Uniform"
                   IsVisible="{Binding ShowPreview}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="18" />
            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray" Text="{Binding ProgressText}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowConsole}" >
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Margin="20,10,0,0" FontWeight="Bold" Text="{x:Static lang:Resources.ConsoleButtonText}" />
              <ToggleButton DockPanel.Dock="Right" Margin="0,0,20,0" IsChecked="{Binding !ShowConsole}">
                <materialIcons:MaterialIcon Kind="Close" />
              </ToggleButton>
              <Rectangle/>
            </DockPanel>

            <ScrollViewer x:Name="ConsoleScrollViewer" Margin="0,10,0,0" Background="#111111" Height="450" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Auto" Foreground="Gray"  PropertyChanged="ConsoleScrollViewer_PropertyChanged">
              <SelectableTextBlock x:Name="ConsoleTextBlock" Margin="20" Text="{Binding ConsoleText}" FontFamily="Consolas" PropertyChanged="ConsoleTextBlock_PropertyChanged" />
            </ScrollViewer>
          </StackPanel>

          <DockPanel Margin="0" Height="30" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">

            <TextBlock Margin="10,10,10,0" DockPanel.Dock="Left" FontSize="10" Text="{Binding LeftStatus}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <ToggleButton IsChecked="{Binding ShowPreview}" FontSize="10" Margin="5,0,5,0">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="ImageOutline" VerticalAlignment="Center" />
                  <TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.PreviewButtonText}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton IsChecked="{Binding ShowConsole}" FontSize="10" Margin="5,0,5,0">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="Console" VerticalAlignment="Center" />
                  <TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.ConsoleButtonText}" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>

            <Rectangle />
          </DockPanel>
        </StackPanel>
      
      
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
          <!-- Workflow: name and import/export/reset (short labels, so they fit beside the
               name at the minimum window width), then the backend (it runs upscaling and
               interpolation alike) on its own line -->
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0">
              <Button Click="ImportCurrentWorkflowButtonClick" ToolTip.Tip="{x:Static lang:Resources.ImportWorkflowButtonText}">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="Import" VerticalAlignment="Center" />
                  <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.WorkflowImportText}" />
                </StackPanel>
              </Button>
              <Button Click="ExportCurrentWorkflowButtonClick" ToolTip.Tip="{x:Static lang:Resources.ExportWorkflowButtonText}">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="Export" VerticalAlignment="Center" />
                  <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.WorkflowExportText}" />
                </StackPanel>
              </Button>
              <Button Click="ResetWorkflow" ToolTip.Tip="{x:Static lang:Resources.ResetWorkflowButtonText}">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="Refresh" VerticalAlignment="Center" />
                  <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="{x:Static lang:Resources.WorkflowResetText}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="500" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="{x:Static lang:Resources.WorkflowNameLabel}" />
              <TextBox Grid.Column="1" Text="{Binding CurrentWorkflow.WorkflowName}"/>
            </Grid>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.UpscalingBackendLabel}" />
            <materialIcons:MaterialIcon Classes="hint" ToolTip.Tip="{x:Static lang:Resources.BackendTooltip}" />
            <ToggleButton IsChecked="{Binding CurrentWorkflow.TensorRtSelected}" Content="TensorRT" Command="{Binding CurrentWorkflow.SetTensorRtSelected}"
                          ToolTip.Tip="{x:Static lang:Resources.UpscalingBackendDescriptionTensorRt}" />
            <ToggleButton IsChecked="{Binding CurrentWorkflow.DirectMlSelected}" Content="DirectML" Command="{Binding CurrentWorkflow.SetDirectMlSelected}"
                          IsVisible="{x:Static vm:UpscaleWorkflow.DirectMlAvailable}" ToolTip.Tip="{x:Static lang:Resources.UpscalingBackendDescriptionDirectMl}" />
          </StackPanel>

          <!-- The sections follow the video through the pipeline: input, what the source is,
               upscaling, interpolation, output. Collapsed, each shows a one-line summary. -->

          <!-- Input -->
          <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.InputSectionExpanded}">
            <Expander.Header>
              <Grid ColumnDefinitions="170,*">
                <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.InputHeader}" />
                <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.InputSummary}" />
              </Grid>
            </Expander.Header>
            <StackPanel>
              <TabControl SelectedIndex="{Binding CurrentWorkflow.SelectedTabIndex}">
                <!-- compact tabs inside the section (the theme's are 48 px tall) -->
                <TabControl.Styles>
                  <Style Selector="TabItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Padding" Value="10,0"/>
                  </Style>
                </TabControl.Styles>
                <TabItem VerticalContentAlignment="Center">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="File" />
                      <TextBlock Margin="5,0,5,0" Text="{x:Static lang:Resources.SingleVideoUpscaleTabHeader}" />
                    </StackPanel>
                  </TabItem.Header>
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
                    <TextBlock Grid.Column="0" Margin="0,0,5,0" Text="{x:Static lang:Resources.InputVideoLabel}" />
                    <materialIcons:MaterialIcon Grid.Column="1" Classes="hint" ToolTip.Tip="{x:Static lang:Resources.InputVideoDescription}" />
                    <TextBox Grid.Column="2" x:Name="InputFileNameTextBox" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.InputFilePath}" HorizontalAlignment="Stretch" DragDrop.AllowDrop="True" />
                    <Button Grid.Column="3" Content="{x:Static lang:Resources.SelectFileButtonText}" Click="OpenInputFileButtonClick" />
                  </Grid>
                </TabItem>
                <TabItem VerticalAlignment="Center">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <materialIcons:MaterialIcon Kind="Folder" />
                      <TextBlock Margin="5,0,5,0" Text="{x:Static lang:Resources.BatchVideoUpscaleTabHeader}" />
                    </StackPanel>
                  </TabItem.Header>
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
                    <TextBlock Grid.Column="0" Margin="0,0,5,0" Text="{x:Static lang:Resources.InputFolderLabel}" />
                    <materialIcons:MaterialIcon Grid.Column="1" Classes="hint" ToolTip.Tip="{x:Static lang:Resources.InputFolderDescription}" />
                    <TextBox Grid.Column="2" x:Name="InputFolderNameTextBox" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.InputFolderPath}" HorizontalAlignment="Stretch" DragDrop.AllowDrop="True" />
                    <Button Grid.Column="3" Content="{x:Static lang:Resources.SelectFolderButtonText}" Click="OpenInputFolderButtonClick" />
                  </Grid>
                </TabItem>
              </TabControl>
            </StackPanel>
          </Expander>

          <!-- Source: what the video is (interlaced, non-square pixels) -->
          <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.SourceSectionExpanded}">
            <Expander.Header>
              <Grid ColumnDefinitions="170,*">
                <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.SourceSettingsHeader}" />
                <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.SourceSummary}" />
              </Grid>
            </Expander.Header>
            <StackPanel Spacing="12">
              <StackPanel Classes="row">
                <TextBlock Classes="label" Text="{x:Static lang:Resources.DeinterlaceLabel}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.DeinterlaceOffSelected}" Content="{x:Static lang:Resources.DeinterlaceOffText}" Command="{Binding CurrentWorkflow.SetDeinterlaceOff}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.DeinterlaceIvtcSelected}" Content="IVTC" Command="{Binding CurrentWorkflow.SetDeinterlaceIvtc}"
                              ToolTip.Tip="{x:Static lang:Resources.DeinterlaceIvtcDescription}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.DeinterlaceBwdifSelected}" Content="{x:Static lang:Resources.DeinterlaceBwdifText}" Command="{Binding CurrentWorkflow.SetDeinterlaceBwdif}"
                              ToolTip.Tip="{x:Static lang:Resources.DeinterlaceBwdifDescription}" />
              </StackPanel>
              <StackPanel Classes="row">
                <TextBlock Classes="label" Text="{x:Static lang:Resources.SquarePixelsLabel}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.SquarePixelsOffSelected}" Content="{x:Static lang:Resources.DeinterlaceOffText}" Command="{Binding CurrentWorkflow.SetSquarePixelsOff}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.SquarePixelsBeforeSelected}" Content="{x:Static lang:Resources.SquarePixelsBeforeText}" Command="{Binding CurrentWorkflow.SetSquarePixelsBefore}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.SquarePixelsAfterSelected}" Content="{x:Static lang:Resources.SquarePixelsAfterText}" Command="{Binding CurrentWorkflow.SetSquarePixelsAfter}" />
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="{x:Static lang:Resources.SquarePixelsDescription}" />
              </StackPanel>
            </StackPanel>
          </Expander>

          <!-- Upscaling -->
          <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.UpscaleSectionExpanded}">
            <Expander.Header>
              <Grid ColumnDefinitions="170,*">
                <CheckBox Classes="sectionTitle" IsChecked="{Binding CurrentWorkflow.EnableUpscale}" Content="{x:Static lang:Resources.UpscaleSettingsHeader}"
                          ToolTip.Tip="{x:Static lang:Resources.EnableUpscalingLabel}" />
                <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.UpscaleSummary}" />
              </Grid>
            </Expander.Header>
            <StackPanel IsEnabled="{Binding CurrentWorkflow.EnableUpscale}">
              <CheckBox HorizontalAlignment="Right" IsChecked="{Binding CurrentWorkflow.ShowAdvancedSettings}" Content="{x:Static lang:Resources.MoreUpscaleSettingsLabel}" />

              <ItemsControl ItemsSource="{Binding CurrentWorkflow.UpscaleSettings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UpscaleModel">
                    <Border Classes="border">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="10">
                          <TextBlock FontWeight="Bold" Text="{Binding ModelHeader}" />
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Margin="0,0,5,0" Text="{x:Static lang:Resources.OnnxModelPathLabel}" />
                            <materialIcons:MaterialIcon Grid.Column="1" Classes="hint" ToolTip.Tip="{x:Static lang:Resources.OnnxModelPathDescription}" />
                            <TextBox Grid.Column="2" Margin="0,0,5,0" Text="{Binding OnnxModelPath}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="3" Content="{x:Static lang:Resources.SelectFileButtonText}" Click="OpenOnnxFileButtonClick" />
                          </Grid>
                          <StackPanel Classes="row" IsVisible="{Binding IsTemporal}">
                            <TextBlock Classes="label" Text="{x:Static lang:Resources.TemporalSceneThresholdLabel}" />
                            <NumericUpDown Value="{Binding TemporalSceneThreshold}" Minimum="0" FormatString="0.000" Maximum="1" Increment="0.01" />
                            <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="{Binding TemporalDescription}" />
                          </StackPanel>
                          <StackPanel Classes="row" IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CurrentWorkflow.ShowAdvancedSettings}">
                            <TextBlock Classes="label" Text="{x:Static lang:Resources.ResizeHeightBeforeUpscaleLabel}" />
                            <NumericUpDown Value="{Binding ResizeHeightBeforeUpscale}" Minimum="0" AllowSpin="False" ShowButtonSpinner="False" />
                            <TextBlock Margin="5,0,0,0">px</TextBlock>
                            <materialIcons:MaterialIcon Classes="hint" Margin="8,0,25,0" ToolTip.Tip="{x:Static lang:Resources.ResizeHeightBeforeUpscaleDescription}" />
                            <TextBlock Classes="label" Text="{x:Static lang:Resources.ResizeFactorBeforeUpscaleLabel}" />
                            <NumericUpDown Value="{Binding ResizeFactorBeforeUpscale}" Minimum="0" AllowSpin="False" ShowButtonSpinner="False" IsEnabled="{Binding EnableResizeFactor}" />
                            <TextBlock Margin="5,0,0,0">%</TextBlock>
                            <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="{x:Static lang:Resources.ResizeFactorBeforeUpscaleDescription}" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CurrentWorkflow.DeleteModel}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="MinusCircle" />
                            <TextBlock Margin="5,0,0,0" Text="{x:Static lang:Resources.RemoveModelButtonText}" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Margin="0,12,0,0" Command="{Binding CurrentWorkflow.AddModel}">
                <StackPanel Orientation="Horizontal">
                  <materialIcons:MaterialIcon Kind="PlusCircle" />
                  <TextBlock Margin="5,0,0,0" Text="{x:Static lang:Resources.AddModelButtonText}" />
                </StackPanel>
              </Button>

              <StackPanel Margin="0,15,0,0" IsVisible="{Binding CurrentWorkflow.ShowTrtEngineSettings}">
                <TextBlock Margin="0,0,0,5" Text="TensorRT Engine Settings" />
                <Border Classes="border">
                  <StackPanel Margin="10">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                      <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">Engine Type</TextBlock>
                        <ToggleButton IsChecked="{Binding CurrentWorkflow.TrtStaticOnnxSelected}" Content="Static ONNX" Command="{Binding CurrentWorkflow.SetTrtStaticOnnx}" />
                        <ToggleButton IsChecked="{Binding CurrentWorkflow.TrtStaticSelected}" Content="Static" Command="{Binding CurrentWorkflow.SetTrtStatic}" />
                        <ToggleButton IsChecked="{Binding CurrentWorkflow.TrtDynamicSelected}" Content="Dynamic" Command="{Binding CurrentWorkflow.SetTrtDynamic}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Foreground="Gray" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="20,0,0,0" xml:space="preserve"><Bold>Static</Bold> (default): fastest; rebuilds per resolution. <Bold>Dynamic</Bold>: one engine for all sizes, slower. <Bold>Static ONNX</Bold>: model's shape.</TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" IsVisible="{Binding CurrentWorkflow.TrtDynamicSelected}">
                      <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">Min Resolution</TextBlock>
                      <ui:FAComboBox IsEditable="True" Width="120" MaxDropDownHeight="600" Text="{Binding CurrentWorkflow.TrtDynamicMinResolution, Mode=TwoWay}" ItemsSource="{Binding CommonResolutions}" />
                      <TextBlock Margin="10,0,5,0" VerticalAlignment="Center">Opt Resolution</TextBlock>
                      <ui:FAComboBox IsEditable="True" Width="120" MaxDropDownHeight="600" Text="{Binding CurrentWorkflow.TrtDynamicOptResolution, Mode=TwoWay}" ItemsSource="{Binding CommonResolutions}" />
                      <TextBlock Margin="10,0,5,0" VerticalAlignment="Center">Max Resolution</TextBlock>
                      <ui:FAComboBox IsEditable="True" Width="120" MaxDropDownHeight="600" Text="{Binding CurrentWorkflow.TrtDynamicMaxResolution, Mode=TwoWay}" ItemsSource="{Binding CommonResolutions}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                      <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">Builder Optimization Level</TextBlock>
                        <ui:FAComboBox IsEditable="True" Width="120" MaxDropDownHeight="600" Text="{Binding CurrentWorkflow.TrtBuilderOptimizationLevel, Mode=TwoWay}" ItemsSource="{Binding BuilderOptimizationLevels}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Foreground="Gray" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="20,0,0,0">Higher levels (0-5) take longer to build the engine but can produce a faster engine. Default is 5.</TextBlock>
                    </Grid>

                    <TextBox Text="{Binding CurrentWorkflow.TrtEngineSettings}" HorizontalAlignment="Stretch" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="70" VerticalContentAlignment="Top" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Expander>

          <!-- Interpolation -->
          <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.InterpolationSectionExpanded}">
            <Expander.Header>
              <Grid ColumnDefinitions="170,*">
                <CheckBox Classes="sectionTitle" IsChecked="{Binding CurrentWorkflow.EnableRife}" Content="{x:Static lang:Resources.InterpolationSettingsHeader}"
                          ToolTip.Tip="{x:Static lang:Resources.EnableInterpolationDescription}" />
                <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.InterpolationSummary}" />
              </Grid>
            </Expander.Header>
            <StackPanel Spacing="12" IsEnabled="{Binding CurrentWorkflow.EnableRife}">
              <StackPanel Classes="row">
                <TextBlock Classes="label" Text="{x:Static lang:Resources.InterpolationModelLabel}" />
                <ComboBox VerticalAlignment="Center" SelectedValue="{Binding CurrentWorkflow.RifeModel}" ItemsSource="{Binding CurrentWorkflow.RifeModelList}" />
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,25,0" ToolTip.Tip="{x:Static lang:Resources.InterpolationModelDescription}" />
                <TextBlock Classes="label" Text="{x:Static lang:Resources.InterpolationFactorLabel}" />
                <NumericUpDown Value="{Binding CurrentWorkflow.RifeFactorNumerator}" Minimum="{Binding CurrentWorkflow.RifeFactorDenominator}" FormatString="0" />
                <TextBlock xml:space="preserve"> / </TextBlock>
                <NumericUpDown Value="{Binding CurrentWorkflow.RifeFactorDenominator}" Minimum="1" Maximum="{Binding CurrentWorkflow.RifeFactorNumerator}" FormatString="0" />
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="{x:Static lang:Resources.InterpolationFactorDescription}" />
              </StackPanel>
              <StackPanel Classes="row">
                <TextBlock Classes="label" Text="{x:Static lang:Resources.SceneDetectionThresholdLabel}" />
                <NumericUpDown Value="{Binding CurrentWorkflow.RifeSceneDetectThreshold}" Minimum="0" FormatString="0.000" Maximum="1" Increment="0.05" />
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="{x:Static lang:Resources.SceneDetectionThresholdDescription}" />
              </StackPanel>
              <StackPanel Classes="row">
                <CheckBox IsChecked="{Binding CurrentWorkflow.RifeBeforeUpscale}" Content="{x:Static lang:Resources.RifeBeforeUpscaleLabel}" />
                <materialIcons:MaterialIcon Classes="hint" Margin="4,0,25,0" ToolTip.Tip="{x:Static lang:Resources.RifeBeforeUpscaleDescription}" />
                <CheckBox IsChecked="{Binding CurrentWorkflow.RifeEnsemble}" Content="{x:Static lang:Resources.EnsembleLabel}" />
                <materialIcons:MaterialIcon Classes="hint" Margin="4,0,0,0" ToolTip.Tip="{x:Static lang:Resources.EnsembleDescription}" />
              </StackPanel>
            </StackPanel>
          </Expander>

          <!-- Output: where it goes and how it's encoded -->
          <Expander Classes="section" IsExpanded="{Binding CurrentWorkflow.OutputSectionExpanded}">
            <Expander.Header>
              <Grid ColumnDefinitions="170,*">
                <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.OutputHeader}" />
                <TextBlock Grid.Column="1" Classes="summary" Text="{Binding CurrentWorkflow.OutputSummary}" />
              </Grid>
            </Expander.Header>
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Margin="0,0,5,0" Text="{x:Static lang:Resources.OutputFolderLabel}" />
                <materialIcons:MaterialIcon Grid.Column="1" Classes="hint" ToolTip.Tip="{x:Static lang:Resources.OutputFolderDescription}" />
                <TextBox Grid.Column="2" x:Name="OutputFolderNameTextBox" Margin="0,0,5,0" Text="{Binding CurrentWorkflow.OutputFolderPath}" HorizontalAlignment="Stretch" DragDrop.AllowDrop="True" />
                <Button Grid.Column="3" Content="{x:Static lang:Resources.SelectFolderButtonText}" Click="OpenOutputFolderButtonClick" />
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Margin="0,0,5,0" Text="{x:Static lang:Resources.OutputFilenameLabel}" />
                <materialIcons:MaterialIcon Grid.Column="1" Classes="hint" ToolTip.Tip="{x:Static lang:Resources.OutputFilenameDescription}" />
                <TextBox Grid.Column="2" Margin="0,0,15,0" Text="{Binding CurrentWorkflow.OutputFilename}" HorizontalAlignment="Stretch" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                  <CheckBox IsChecked="{Binding CurrentWorkflow.OverwriteExistingVideos}" Content="{x:Static lang:Resources.AllowOverwriteLabel}" />
                  <materialIcons:MaterialIcon Classes="hint" Margin="4,0,0,0" ToolTip.Tip="{x:Static lang:Resources.AllowOverwriteDescription}" />
                </StackPanel>
              </Grid>
              <StackPanel Classes="row">
                <TextBlock Classes="label" Text="{x:Static lang:Resources.FfmpegPresetsLabel}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.FfmpegHevcNvencSelected}" Content="NVENC HEVC" Command="{Binding CurrentWorkflow.SetFfmpegHevcNvenc}"
                              ToolTip.Tip="{x:Static lang:Resources.FfmpegPresetsDescriptionNvencHevc}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.FfmpegX265Selected}" Content="x265 (CPU)" Command="{Binding CurrentWorkflow.SetFfmpegX265}"
                              ToolTip.Tip="{x:Static lang:Resources.FfmpegPresetsDescriptionX265}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.FfmpegX264Selected}" Content="x264 (CPU)" Command="{Binding CurrentWorkflow.SetFfmpegX264}"
                              ToolTip.Tip="{x:Static lang:Resources.FfmpegPresetsDescriptionX264}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.FfmpegLosslessSelected}" Content="Lossless (CPU)" Command="{Binding CurrentWorkflow.SetFfmpegLossless}"
                              ToolTip.Tip="{x:Static lang:Resources.FfmpegPresetsDescriptionLossless}" />
                <TextBlock Classes="label" Margin="25,0,5,0" Text="Output format" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.OutputPixFmt420P8Selected}" Content="8-bit 4:2:0" Command="{Binding CurrentWorkflow.SetOutputPixFmt420P8}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.OutputPixFmt420P10Selected}" Content="10-bit 4:2:0" Command="{Binding CurrentWorkflow.SetOutputPixFmt420P10}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.OutputPixFmt444P8Selected}" Content="8-bit 4:4:4" Command="{Binding CurrentWorkflow.SetOutputPixFmt444P8}" />
                <ToggleButton IsChecked="{Binding CurrentWorkflow.OutputPixFmt444P10Selected}" Content="10-bit 4:4:4" Command="{Binding CurrentWorkflow.SetOutputPixFmt444P10}" />
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="10-bit reduces banding (default, matches the old pipeline). 4:4:4 preserves full chroma but needs a CPU encoder (x265/x264/Lossless) and produces larger files." />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" Margin="0,0,5,0" Text="{x:Static lang:Resources.FfmpegOutputSettingsLabel}" />
                <materialIcons:MaterialIcon Grid.Column="1" Classes="hint" ToolTip.Tip="{x:Static lang:Resources.FfmpegOutputSettingsDescription}" />
                <TextBox Grid.Column="2" Text="{Binding CurrentWorkflow.FfmpegVideoSettings}" HorizontalAlignment="Stretch" />
              </Grid>
              <StackPanel Classes="row">
                <TextBlock Classes="label" Text="{x:Static lang:Resources.FinalResizeHeightLabel}" />
                <NumericUpDown Value="{Binding CurrentWorkflow.FinalResizeHeight}" Minimum="0" AllowSpin="False" ShowButtonSpinner="False" Classes="clearButton" />
                <TextBlock Margin="5,0,0,0">px</TextBlock>
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,25,0" ToolTip.Tip="{x:Static lang:Resources.FinalResizeHeightDescription}" />
                <TextBlock Classes="label" Text="{x:Static lang:Resources.FinalResizeFactorLabel}" />
                <NumericUpDown Value="{Binding CurrentWorkflow.FinalResizeFactor}" IsEnabled="{Binding CurrentWorkflow.EnableFinalResizeFactor}" />
                <TextBlock Margin="5,0,0,0">%</TextBlock>
                <materialIcons:MaterialIcon Classes="hint" Margin="8,0,0,0" ToolTip.Tip="{x:Static lang:Resources.FinalResizeFactorDescription}" />
              </StackPanel>
            </StackPanel>
          </Expander>

        </StackPanel>
      </ScrollViewer>
      </DockPanel>

      <!-- Settings Overlay -->
      <ScrollViewer IsVisible="{Binding ShowAppSettings}" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,30" Grid.Column="1">
        <StackPanel>
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Text="{x:Static lang:Resources.AppSettingsHeader}" />
         
          </DockPanel>

          <!-- App Settings -->
          <Border Classes="border">
            <StackPanel>
              <StackPanel IsVisible="{Binding IsInstalled}">
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*" Margin="10,10,0,10">
                    <CheckBox Grid.Column="0" IsChecked="{Binding AutoUpdateEnabled}" Content="{x:Static lang:Resources.AutoUpdateLabel}" />
                    <TextBlock Grid.Column="1" Classes="help" Text="{x:Static lang:Resources.AutoUpdateDescription}" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                    <TextBlock Text="{x:Static lang:Resources.CurrentVersionLabel}" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding AppVersion}" Margin="20,0,0,0" />
                    <hypertext:Hyperlink VerticalAlignment="Center" Margin="20,0,0,0" Url="https://github.com/the-database/VideoJaNai/releases" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                    <TextBlock VerticalAlignment="Center" Text="{Binding UpdateStatusText}" Margin="0,0,0,0" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10" IsVisible="{Binding ShowCheckUpdateButton}">
                    <Button Command="{Binding CheckForUpdates}" Content="{x:Static lang:Resources.CheckForUpdatesNowButtonText}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="10,10,0,10" IsVisible="{Binding ShowApplyButton}">
                    <Button Command="{Binding ApplyUpdate}" Content="{x:Static lang:Resources.RestartToUpdateButtonText}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding !IsInstalled}">
                <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                  <TextBlock Text="{x:Static lang:Resources.AppNotInstalledText}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Components -->
          <DockPanel Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Text="Components"></TextBlock>
          </DockPanel>
          <Border Classes="border">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                <TextBlock VerticalAlignment="Center" Text="GPU:" />
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Margin="8,0,0,0" Text="{Binding GpuStatusText}" />
                <Button Margin="20,0,0,0" Content="Refresh" Command="{Binding RefreshComponents}" IsEnabled="{Binding AllowReinstall}" />
              </StackPanel>

              <ItemsControl x:Name="ComponentsList" Margin="10,10,0,0" ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComponentItem">
                    <StackPanel Margin="0,4,0,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Width="320" Text="{Binding Title}" />
                        <TextBlock VerticalAlignment="Center" Width="80" Foreground="Gray" Text="{Binding SizeText}" />
                        <TextBlock VerticalAlignment="Center" Width="100" Foreground="Gray" Text="{Binding StateText}" />
                        <Button Content="Install" IsVisible="{Binding CanInstall}"
                                Command="{Binding #ComponentsList.((vm:MainWindowViewModel)DataContext).InstallComponent}"
                                CommandParameter="{Binding}" />
                        <Button Content="Remove" IsVisible="{Binding CanRemove}"
                                Command="{Binding #ComponentsList.((vm:MainWindowViewModel)DataContext).RemoveComponent}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                      <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,2,10,0" Text="{Binding Description}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Margin="10,10,0,0" Foreground="Gray" FontFamily="Consolas" TextWrapping="WrapWithOverflow" Text="{Binding ComponentStatusText}" />

            </StackPanel>
          </Border>

          <Border Classes="border">
            <ToggleButton DockPanel.Dock="Right" Margin="10,10,0,10" IsChecked="{Binding !RequestShowAppSettings}">
              <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="ArrowBackCircle" />
                <TextBlock Margin="5,0,0,0" Text="{x:Static lang:Resources.ReturnButtonText}" />
              </StackPanel>
            </ToggleButton>
          </Border>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid IsVisible="{Binding IsExtractingBackend}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <StackPanel>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding BackendSetupMainStatus}" />
        <ScrollViewer Margin="0,10,0,0" Background="#111111" Height="450" Width="1200" HorizontalScrollBarVisibility="Auto" Foreground="Gray"  PropertyChanged="ConsoleScrollViewer_PropertyChanged">
          <SelectableTextBlock Margin="20" Text="{Binding BackendSetupSubStatusText}" FontFamily="Consolas" PropertyChanged="ConsoleTextBlock_PropertyChanged" />
        </ScrollViewer>
        <StackPanel IsVisible="{Binding ExtractingBackendFailed}">
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Width="1200">
            <Button FontWeight="Bold" Background="Red" Content="Reinstall components" Click="ReinstallBackendClick" IsEnabled="{Binding AllowReinstall}" />
            <TextBlock Foreground="Gray" Width="400" TextWrapping="WrapWithOverflow" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
              Reinstall the recommended components. Try this if you are having any problems getting upscales to work. This process may take several minutes.
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
