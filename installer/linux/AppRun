#!/bin/sh
# AppImage entrypoint for VideoJaNai.
#
# The AppImage mounts read-only (squashfs), but VideoJaNai writes: TensorRT engines build next to the
# ONNX models, and the app writes animejanai.conf for aji_encode. So the writable animejanai/ parts
# (onnx models, RIFE models) are mirrored into $XDG_DATA_HOME/VideoJaNai, and the app is pointed at
# it (VIDEOJANAI_DATA_DIR) while the engine binaries stay in the image (VIDEOJANAI_ROOT). The
# updater is not shipped in the AppImage: a new version is a new AppImage.
set -eu

HERE="$(dirname "$(readlink -f "$0")")"

# Desktop integration:
#   <AppImage> --install     register a menu entry
#   <AppImage> --uninstall   remove it
case "${1:-}" in
  --install|--uninstall)
    APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    ICONS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
    desktop="$APPS/videojanai.desktop"
    if [ "$1" = "--uninstall" ]; then
        rm -f "$desktop" "$ICONS/videojanai.png"
        update-desktop-database "$APPS" 2>/dev/null || true
        echo "Removed the VideoJaNai menu entry."
        echo "(models and cached engines in ${XDG_DATA_HOME:-$HOME/.local/share}/VideoJaNai are kept; delete that folder to clear them)"
        exit 0
    fi
    target="${APPIMAGE:-$HERE/AppRun}"
    [ -z "${APPIMAGE:-}" ] && echo "warning: \$APPIMAGE unset (run the .AppImage directly, not extracted); using $target" >&2
    mkdir -p "$APPS" "$ICONS"
    [ -f "$HERE/videojanai.png" ] && cp -f "$HERE/videojanai.png" "$ICONS/videojanai.png"
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=VideoJaNai
Comment=Upscale videos with ONNX models on NVIDIA TensorRT
Exec="$target"
TryExec=$target
Icon=videojanai
Terminal=false
Categories=AudioVideo;Video;
StartupNotify=true
EOF
    update-desktop-database "$APPS" 2>/dev/null || true
    echo "Installed: 'VideoJaNai' now appears in your app menu."
    echo "  entry:    $desktop"
    echo "  launches: $target"
    exit 0
    ;;
esac

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/VideoJaNai"
AJ="$DATA/animejanai"
mkdir -p "$AJ/onnx" "$AJ/rife" "$AJ/inference"

# Bundled ONNX models: engines build next to them, so they must be writable. Only missing files are
# copied, so models the user added (and their engines) are kept across versions.
cp -rn "$HERE/animejanai/onnx/." "$AJ/onnx/" 2>/dev/null || true

# TensorRT (the runtime and this PC's builder kernels) comes from the shared pack store
# (~/.local/share/the-database/aji, shared with the other libaji apps), installed by the image's
# aji-runtime from the runtime release manifest.json pins, once per version. The RIFE models come
# from this release's component pack into $DATA. Both run in the background so the window appears
# right away (the app shows TensorRT as missing until it's done); progress goes to $DATA/fetch.log.
# libaji, aji_encode and the app find the store's packs through $AJ/inference/aji-runtime.json,
# which AJI_RUNTIME_JSON names (libaji's own folder is the read-only image). The store keeps them
# while this AppImage file exists (its ref's app_path); packs no AppImage or app uses any more are
# freed. aji-runtime and 7zz are copied out of the image first: the mount goes away when the app
# exits, and the install may outlive it. A failure is non-fatal (offline, or a draft release whose
# assets need auth): it runs again on the next launch.
ver="$(cat "$HERE/version.txt" 2>/dev/null || echo "")"
relbase="https://github.com/the-database/VideoJaNai/releases/download/${ver}"
manifest="$HERE/manifest.json"
url="$(sed -n 's/.*"index_url": *"\([^"]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
sha="$(sed -n 's/.*"index_sha256": *"\([0-9a-f]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
export AJI_RUNTIME_JSON="$AJ/inference/aji-runtime.json"
stamp="$DATA/aji-runtime.stamp"
target="${APPIMAGE:-$HERE/AppRun}"
need_trt=0
need_rife=0
if nvidia-smi -L >/dev/null 2>&1 && [ -x "$HERE/aji-runtime" ] && [ -n "$url" ] && [ -n "$sha" ] &&
   { [ ! -f "$AJI_RUNTIME_JSON" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$ver" ]; }; then
    need_trt=1
fi
ls "$AJ/rife"/*.onnx >/dev/null 2>&1 || need_rife=1
# One install at a time; the lock holds the installing shell's pid, so a lock left by an install
# that was killed (shutdown, ...) is noticed and cleared on the next launch.
lock="$DATA/.fetch.lock"
if [ -f "$lock" ] && ! kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; then
    rm -f "$lock"
fi
if { [ $need_trt = 1 ] || [ $need_rife = 1 ]; } && [ ! -f "$lock" ]; then
    cp -f "$HERE/7zz" "$DATA/7zz" 2>/dev/null || true
    cp -f "$HERE/aji-runtime" "$DATA/aji-runtime" 2>/dev/null || true
    export DATA AJ relbase ver url sha stamp target need_trt need_rife lock
    # setsid: its own session, so closing the app (or Ctrl+C in its terminal) doesn't stop it
    fetcher='
        echo $$ > "$lock"
        trap '\''rm -f "$lock"'\'' EXIT
        if [ "$need_trt" = 1 ]; then
            echo "VideoJaNai: installing TensorRT into the shared pack store (one-time)..."
            if "$DATA/aji-runtime" ensure --app-id videojanai-appimage --app-path "$target" \
                   --app-version "$ver" --index "$url" --index-sha256 "$sha" --want trt --aji-dir "$AJ/inference"; then
                echo "$ver" > "$stamp"
                # builder kernels an AppImage from before the store fetched here
                rm -f "$AJ/inference"/libnvinfer_builder_resource_*
            else
                echo "VideoJaNai: the TensorRT install failed; it runs again on the next launch."
            fi
        fi
        if [ "$need_rife" = 1 ] && [ -n "$ver" ] && command -v curl >/dev/null 2>&1; then
            pack="component-rife-linux-x64.7z"
            echo "VideoJaNai: fetching the RIFE interpolation models (~450 MB, one-time)..."
            if curl -fsSL "$relbase/$pack" -o "$DATA/$pack.part"; then
                "$DATA/7zz" x -snl -y -o"$DATA" "$DATA/$pack.part" >/dev/null 2>&1 || true
            else
                echo "VideoJaNai: could not fetch $pack (offline / draft release?)."
            fi
            rm -f "$DATA/$pack.part"
        fi
        true'
    if command -v setsid >/dev/null 2>&1; then
        setsid sh -c "$fetcher" >"$DATA/fetch.log" 2>&1 < /dev/null &
    else
        nohup sh -c "$fetcher" >"$DATA/fetch.log" 2>&1 < /dev/null &
    fi
fi

export VIDEOJANAI_ROOT="$HERE"
export VIDEOJANAI_DATA_DIR="$AJ"
# aji_encode loads libaji from the image; libaji, aji_encode and trtexec take TensorRT from the
# shared pack store (AJI_RUNTIME_JSON); the app puts its folder on aji_encode's loader path.
export LD_LIBRARY_PATH="$AJ/inference:${LD_LIBRARY_PATH:-}"
cd "$DATA"
exec "$HERE/VideoJaNai" "$@"
